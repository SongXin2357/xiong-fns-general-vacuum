theorem N0005Attempt.momentum_identification : ∀ {m : ℕ} {ρ₀ : N0005Attempt.R2 → ℝ}
  {v u₀ : N0005Attempt.R2 → EuclideanSpace ℝ (Fin m)},
  MeasureTheory.LocallyIntegrable (fun x => ρ₀ x • v x) MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable (fun x => ρ₀ x • u₀ x) MeasureTheory.volume →
      (∀ (φ : N0005Attempt.R2 → ℝ),
          ContDiff ℝ (↑⊤) φ →
            HasCompactSupport φ →
              ∫ (x : N0005Attempt.R2), φ x • ρ₀ x • v x = ∫ (x : N0005Attempt.R2), φ x • ρ₀ x • u₀ x) →
        ∀ᵐ (x : N0005Attempt.R2), ρ₀ x • v x = ρ₀ x • u₀ x :=
fun {m} {ρ₀} {v u₀} hv hu₀ htest => ae_eq_of_integral_contDiff_smul_eq hv hu₀ htest
theorem N0005Attempt.positive_density_transfer : ∀ {m : ℕ} {p : ENNReal} {ρ₀ : N0005Attempt.R2 → ℝ}
  {v u₀ : N0005Attempt.R2 → EuclideanSpace ℝ (Fin m)},
  MeasureTheory.MemLp v p MeasureTheory.volume →
    (∀ᵐ (x : N0005Attempt.R2), ρ₀ x • v x = ρ₀ x • u₀ x) →
      (∀ᵐ (x : N0005Attempt.R2), 0 < ρ₀ x) → MeasureTheory.MemLp u₀ p MeasureTheory.volume :=
fun {m} {p} {ρ₀} {v u₀} hv heq hpos =>
  (fun hfg => MeasureTheory.MemLp.ae_eq hfg hv)
    (Filter.mp_mem hpos
      (Filter.mp_mem heq
        (Filter.univ_mem' (id fun x hx hp => smul_right_injective (EuclideanSpace ℝ (Fin m)) (ne_of_gt hp) hx))))
