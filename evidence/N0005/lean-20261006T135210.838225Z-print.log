theorem N0005Attempt.density_error_bound.{u_1, u_2} : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure α}
  {ρ ρ₀ φ : α → ℝ} {u : α → E} {δ : ℝ},
  0 ≤ δ →
    MeasureTheory.AEStronglyMeasurable (fun x => ((ρ x - ρ₀ x) * φ x) • u x) μ →
      MeasureTheory.Integrable (fun x => ‖φ x‖ * ‖u x‖) μ →
        (∀ᵐ (x : α) ∂μ, φ x ≠ 0 → ‖ρ x - ρ₀ x‖ ≤ δ) →
          MeasureTheory.Integrable (fun x => ((ρ x - ρ₀ x) * φ x) • u x) μ ∧
            ‖∫ (x : α), ((ρ x - ρ₀ x) * φ x) • u x ∂μ‖ ≤ δ * ∫ (x : α), ‖φ x‖ * ‖u x‖ ∂μ :=
fun {α} {E} [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {μ} {ρ ρ₀ φ} {u} {δ} hδ hm
    hbase hρ =>
  have hdom :=
    Filter.mp_mem hρ
      (Filter.univ_mem'
        (id fun x hx =>
          if hφ : φ x = 0 then
            of_eq_true
              (Eq.trans
                (congr
                  (congrArg LE.le
                    (Eq.trans
                      (congrArg norm
                        (Eq.trans
                          (congrFun'
                            (congrArg HSMul.hSMul
                              (Eq.trans (congrArg (HMul.hMul (ρ x - ρ₀ x)) hφ) (mul_zero (ρ x - ρ₀ x))))
                            (u x))
                          (zero_smul ℝ (u x))))
                      norm_zero))
                  (Eq.trans
                    (congrArg (HMul.hMul δ)
                      (Eq.trans (congrFun' (congrArg HMul.hMul (Eq.trans (congrArg norm hφ) norm_zero)) ‖u x‖)
                        (zero_mul ‖u x‖)))
                    (mul_zero δ)))
                (Std.le_refl._simp_1 0))
          else
            Eq.mpr (id (congrArg (fun _a => _a ≤ δ * (‖φ x‖ * ‖u x‖)) (norm_smul ((ρ x - ρ₀ x) * φ x) (u x))))
              (Eq.mpr (id (congrArg (fun _a => _a * ‖u x‖ ≤ δ * (‖φ x‖ * ‖u x‖)) (norm_mul (ρ x - ρ₀ x) (φ x))))
                (Eq.mpr (id (congrArg (fun _a => _a ≤ δ * (‖φ x‖ * ‖u x‖)) (mul_assoc ‖ρ x - ρ₀ x‖ ‖φ x‖ ‖u x‖)))
                  (mul_le_mul_of_nonneg_right (hx hφ) (mul_nonneg (norm_nonneg (φ x)) (norm_nonneg (u x))))))));
  have hg := MeasureTheory.Integrable.const_mul hbase δ;
  ⟨MeasureTheory.Integrable.mono' hg hm hdom,
    Eq.mp
      (congrArg (LE.le ‖∫ (x : α), ((ρ x - ρ₀ x) * φ x) • u x ∂μ‖)
        (MeasureTheory.integral_const_mul δ fun a => ‖φ a‖ * ‖u a‖))
      (MeasureTheory.norm_integral_le_of_norm_le hg hdom)⟩
theorem N0005Attempt.test_velocity_product_integrable.{u_1, u_2} : ∀ {α : Type u_1} {E : Type u_2}
  [inst : MeasurableSpace α] [inst_1 : NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {μ : MeasureTheory.Measure α} {p q : ENNReal} [p.HolderConjugate q] {u : α → E} {φ : α → ℝ},
  MeasureTheory.MemLp u p μ → MeasureTheory.MemLp φ q μ → MeasureTheory.Integrable (fun x => ‖φ x‖ * ‖u x‖) μ :=
fun {α} {E} [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {μ} {p q}
    [p.HolderConjugate q] {u} {φ} hu hφ =>
  MeasureTheory.memLp_one_iff_integrable.mp
    (MeasureTheory.MemLp.mul (MeasureTheory.MemLp.norm hu) (MeasureTheory.MemLp.norm hφ))
theorem N0005Attempt.test_velocity_product_bound.{u_1, u_2} : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure α} {p q : ℝ},
  p.HolderConjugate q →
    ∀ {u : α → E} {φ : α → ℝ},
      MeasureTheory.MemLp u (ENNReal.ofReal p) μ →
        MeasureTheory.MemLp φ (ENNReal.ofReal q) μ →
          ∫ (x : α), ‖φ x‖ * ‖u x‖ ∂μ ≤ (∫ (x : α), ‖φ x‖ ^ q ∂μ) ^ (1 / q) * (∫ (x : α), ‖u x‖ ^ p ∂μ) ^ (1 / p) :=
fun {α} {E} [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {μ} {p q} hpq {u} {φ} hu
    hφ =>
  Eq.mp
    (congr
      (congrArg LE.le
        (congrArg (MeasureTheory.integral μ)
          (funext fun a => congr (congrArg HMul.hMul (norm_norm (φ a))) (norm_norm (u a)))))
      (congr
        (congrArg HMul.hMul
          (congrFun'
            (congrArg HPow.hPow
              (congrArg (MeasureTheory.integral μ)
                (funext fun a => congrFun' (congrArg HPow.hPow (norm_norm (φ a))) q)))
            (1 / q)))
        (congrFun'
          (congrArg HPow.hPow
            (congrArg (MeasureTheory.integral μ) (funext fun a => congrFun' (congrArg HPow.hPow (norm_norm (u a))) p)))
          (1 / p))))
    (MeasureTheory.integral_mul_norm_le_Lp_mul_Lq (Real.HolderConjugate.symm hpq) (MeasureTheory.MemLp.norm hφ)
      (MeasureTheory.MemLp.norm hu))
theorem N0005Attempt.density_error_tendsto.{u_1, u_2, u_3} : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure α}
  {ι : Type u_3} {l : Filter ι} {ρ : ι → α → ℝ} {ρ₀ φ : α → ℝ} {u : ι → α → E} {δ : ι → ℝ} {C : ℝ},
  (∀ (i : ι), 0 ≤ δ i) →
    Filter.Tendsto δ l (nhds 0) →
      (∀ (i : ι), MeasureTheory.AEStronglyMeasurable (fun x => ((ρ i x - ρ₀ x) * φ x) • u i x) μ) →
        (∀ (i : ι), MeasureTheory.Integrable (fun x => ‖φ x‖ * ‖u i x‖) μ) →
          (∀ (i : ι), ∫ (x : α), ‖φ x‖ * ‖u i x‖ ∂μ ≤ C) →
            (∀ (i : ι), ∀ᵐ (x : α) ∂μ, φ x ≠ 0 → ‖ρ i x - ρ₀ x‖ ≤ δ i) →
              Filter.Tendsto (fun i => ∫ (x : α), ((ρ i x - ρ₀ x) * φ x) • u i x ∂μ) l (nhds 0) :=
fun {α} {E} [MeasurableSpace α] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {μ} {ι} {l} {ρ} {ρ₀ φ} {u}
    {δ} {C} hδ hδlim hm hbase hbound hρ =>
  squeeze_zero_norm
    (fun i =>
      LE.le.trans (N0005Attempt.density_error_bound (hδ i) (hm i) (hbase i) (hρ i)).right
        (mul_le_mul_of_nonneg_left (hbound i) (hδ i)))
    (Eq.mp (congrArg (Filter.Tendsto (fun x => δ x * C) l) (congrArg nhds (zero_mul C)))
      (Filter.Tendsto.mul_const C hδlim))
