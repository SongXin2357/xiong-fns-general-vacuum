N0005ExactAttempt.InitialRepresentativeStatement : Prop
def N0005ExactAttempt.InitialRepresentativeStatement : Prop :=
∀ (m : ℕ) (p T C : ℝ) (ρ : ℝ → R2 → ℝ) (ρ₀ : R2 → ℝ) (u : ℝ → Velocity m) (u₀ : Velocity m),
  1 < p →
    0 < T →
      0 ≤ C →
        (∀ t ∈ Ioo 0 T, MemLp (u t) (ENNReal.ofReal p) volume) →
          (∀ t ∈ Ioo 0 T, (eLpNorm (u t) (ENNReal.ofReal p) volume).toReal ≤ C) →
            (∀ (K : Set R2), IsCompact K → MemLp ρ₀ ∞ (volume.restrict K)) →
              (∀ (K : Set R2), IsCompact K → TendstoUniformlyOn ρ ρ₀ (𝓝[Ioo 0 T] 0) K) →
                (∀ t ∈ Ioo 0 T, LocallyIntegrable (fun x => ρ t x • u t x) volume) →
                  LocallyIntegrable (fun x => ρ₀ x • u₀ x) volume →
                    (∀ (φ : R2 → ℝ),
                        ContDiff ℝ ∞ φ →
                          HasCompactSupport φ →
                            Tendsto (fun t => ∫ (x : R2), φ x • ρ t x • u t x) (𝓝[Ioo 0 T] 0)
                              (𝓝 (∫ (x : R2), φ x • ρ₀ x • u₀ x))) →
                      ∃ v, MemLp v (ENNReal.ofReal p) volume ∧ ∀ᵐ (x : R2), ρ₀ x • v x = ρ₀ x • u₀ x
