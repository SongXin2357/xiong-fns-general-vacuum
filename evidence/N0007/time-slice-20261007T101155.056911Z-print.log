theorem FNSTree.N0007.temporal_residual_ae_zero : ∀ (F : ℝ → ℝ),
  MeasureTheory.Integrable F MeasureTheory.volume →
    (∀ (η : ℝ → ℝ), ContDiff ℝ (↑⊤) η → HasCompactSupport η → ∫ (t : ℝ), η t * F t = 0) → ∀ᵐ (t : ℝ), F t = 0 :=
fun F hF hweak =>
  ae_eq_zero_of_integral_contDiff_smul_eq_zero (MeasureTheory.Integrable.locallyIntegrable hF) fun η hη hc =>
    id (hweak η hη hc)
'FNSTree.N0007.temporal_residual_ae_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem FNSTree.N0007.common_time_ae_for_countable_tests.{u_1} : ∀ {J : Type u_1} [Countable J] (F : Fin 2 → J → ℝ → ℝ),
  (∀ (i : Fin 2) (j : J), MeasureTheory.Integrable (F i j) MeasureTheory.volume) →
    (∀ (i : Fin 2) (j : J) (η : ℝ → ℝ), ContDiff ℝ (↑⊤) η → HasCompactSupport η → ∫ (t : ℝ), η t * F i j t = 0) →
      ∀ᵐ (t : ℝ), ∀ (i : Fin 2) (j : J), F i j t = 0 :=
fun {J} [Countable J] F hF hweak =>
  have hJ := fun i =>
    eventually_countable_forall.mpr fun j => FNSTree.N0007.temporal_residual_ae_zero (F i j) (hF i j) (hweak i j);
  Filter.eventually_all.mpr hJ
'FNSTree.N0007.common_time_ae_for_countable_tests' depends on axioms: [propext, Classical.choice, Quot.sound]
