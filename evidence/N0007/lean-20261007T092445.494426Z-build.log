info: ../N0007AuxCheck.lean:4:0: theorem FNSTree.N0007.weighted_source_integrable : ∀ (ρ v : FNSTree.N0007.Plane → ℝ),
  Measurable ρ →
    (∀ᵐ (x : FNSTree.N0007.Plane), 0 ≤ ρ x) →
      MeasureTheory.Integrable ρ MeasureTheory.volume →
        MeasureTheory.MemLp (fun x => √(ρ x) * v x) 2 MeasureTheory.volume →
          MeasureTheory.Integrable (fun x => ρ x * v x) MeasureTheory.volume :=
fun ρ v hρmeas hρnonneg hρint hweighted =>
  have hsqrt_meas := Measurable.aestronglyMeasurable (Measurable.sqrt hρmeas);
  have hsqrt_sq := Filter.mp_mem hρnonneg (Filter.univ_mem' (id fun x hx => Real.sq_sqrt hx));
  have hsqrt_int := MeasureTheory.Integrable.congr hρint (Filter.EventuallyEq.symm hsqrt_sq);
  have hsqrt := (MeasureTheory.memLp_two_iff_integrable_sq hsqrt_meas).mpr hsqrt_int;
  have hproduct := MeasureTheory.MemLp.mul' hweighted hsqrt;
  have htarget :=
    (fun hfg => MeasureTheory.MemLp.ae_eq hfg hproduct)
      (Filter.mp_mem hρnonneg
        (Filter.univ_mem'
          (id fun x hx =>
            Eq.mpr (id (congrArg (fun _a => _a = ρ x * v x) (Eq.symm (mul_assoc (√(ρ x)) (√(ρ x)) (v x)))))
              (Eq.mpr (id (congrArg (fun _a => _a * v x = ρ x * v x) (Real.mul_self_sqrt hx)))
                (Eq.refl (ρ x * v x))))));
  MeasureTheory.memLp_one_iff_integrable.mp htarget
